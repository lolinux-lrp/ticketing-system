generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String            @id @default(uuid())
  name               String?
  email              String?           @unique
  password           String?
  role               Role              @default(CUSTOMER)
  createdAt          DateTime          @default(now())
  emailVerified      DateTime?
  image              String?
  deletedAt          DateTime?
  accounts           Account[]
  meetingsCreated    Meeting[]         @relation("MeetingHost")
  meetingAttendances MeetingAttendee[]
  sessions           Session[]
  assignedTickets    Ticket[]          @relation("AssignedTickets")
  createdTickets     Ticket[]          @relation("CreatedTickets")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id                String          @id @default(uuid())
  name              String          @unique
  contractStart     DateTime?
  contractEnd       DateTime?
  expirationSubject String?
  expirationBody    String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tickets           Ticket[]
  domains           ProjectDomain[]
}

model ProjectDomain {
  id        String  @id @default(uuid())
  domain    String  @unique
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Ticket {
  id           String                   @id @default(uuid())
  title        String
  description  String
  status       Status                   @default(OPEN)
  priority     Priority                 @default(P3)
  createdById  String
  assignedToId String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  lastActivityAt DateTime               @default(now())
  searchVector Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, ((COALESCE(title, ''::text) || ' '::text) || COALESCE(description, ''::text)))"))
  contactEmail String?
  ccEmails     String[]                 @default([])
  projectId        String?
  resolution       String?
  resolvedAt       DateTime?
  adminEscalatedAt DateTime?
  execEscalatedAt  DateTime?
  threadId         String?
  messageId        String?
  messages         TicketMessage[]
  meetings     Meeting[]
  assignedTo   User?                    @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy    User                     @relation("CreatedTickets", fields: [createdById], references: [id])
  project      Project?                 @relation(fields: [projectId], references: [id])

  @@index([createdById])
  @@index([assignedToId])
  @@index([status, priority])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([priority, createdAt])
  @@index([projectId])
  @@index([lastActivityAt])
  @@index([threadId])
  @@index([searchVector], type: Gin)
  @@index([status, lastActivityAt])
}


model Meeting {
  id                    String            @id @default(cuid())
  title                 String
  description           String?
  startTime             DateTime
  endTime               DateTime
  meetingUrl            String
  externalGoogleEventId String?
  ticketId              String?
  createdById           String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  reminderSentAt        DateTime?
  status                MeetingStatus     @default(SCHEDULED)
  createdBy             User              @relation("MeetingHost", fields: [createdById], references: [id])
  ticket                Ticket?           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attendees             MeetingAttendee[]

  @@index([ticketId])
  @@index([createdById])
  @@index([reminderSentAt, startTime])
}

model MeetingAttendee {
  id         String   @id @default(cuid())
  meetingId  String
  userId     String?
  email      String?
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@unique([meetingId, email])
  @@index([meetingId])
  @@index([userId])
}

enum Role {
  ADMIN
  USER
  CUSTOMER
}

enum Status {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  P1 // Critical / Urgent
  P2 // High / Significant
  P3 // Medium / General
  P4 // Low / Info
}

model ProcessedMessage {
  id        String   @id
  status    String   @default("PROCESSING")
  lockedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([status, lockedAt])
}

enum TicketMessageSenderType {
  CLIENT
  AGENT
  SYSTEM
}

model TicketMessage {
  id          String                  @id @default(uuid())
  ticketId    String
  ticket      Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType  TicketMessageSenderType
  senderEmail String
  content     String                  @db.Text
  to          String?
  cc          String?
  bcc         String?
  messageId   String?                 @unique
  createdAt   DateTime                @default(now())

  @@index([ticketId, createdAt, id])
}

enum MeetingStatus {
  SCHEDULED
  CANCELLED
}
